FUNCTION_BLOCK "FB_Counters"
TITLE = 'Production counters and throughput'
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0
//  Throughput: parcels counted in a rolling 60 s window (12 buckets of 5 s), x 60 = per hour.

   VAR_INPUT
      DivertedLane : Int;
      Rejected : Bool;
      Oversize : Bool;
      Lost : Bool;
      ResetCounters : Bool;
   END_VAR

   VAR_IN_OUT
      Counters : "UDT_LaneCounters";
   END_VAR

   VAR
      Buckets : Array[0..11] of Int;
      BucketIdx : Int;
      tonTick {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;
   END_VAR

   VAR_TEMP
      i : Int;
      sum : DInt;
      counted : Bool;
   END_VAR

BEGIN
   IF #ResetCounters THEN
      FOR #i := 1 TO 3 DO
         #Counters.Lane[#i] := 0;
      END_FOR;
      #Counters.Rejected := 0;
      #Counters.Total := 0;
      #Counters.Oversize := 0;
      #Counters.Lost := 0;
      FOR #i := 0 TO 11 DO
         #Buckets[#i] := 0;
      END_FOR;
   END_IF;

   #counted := FALSE;
   IF #DivertedLane >= 1 AND #DivertedLane <= 3 THEN
      #Counters.Lane[#DivertedLane] := #Counters.Lane[#DivertedLane] + 1;
      #counted := TRUE;
   END_IF;
   IF #Rejected THEN
      #Counters.Rejected := #Counters.Rejected + 1;
      #counted := TRUE;
   END_IF;
   IF #Oversize THEN
      #Counters.Oversize := #Counters.Oversize + 1;
   END_IF;
   IF #Lost THEN
      #Counters.Lost := #Counters.Lost + 1;
   END_IF;
   IF #counted THEN
      #Counters.Total := #Counters.Total + 1;
      #Buckets[#BucketIdx] := #Buckets[#BucketIdx] + 1;
   END_IF;

   // advance the rolling window every 5 s
   #tonTick(IN := NOT #tonTick.Q, PT := T#5S);
   IF #tonTick.Q THEN
      #BucketIdx := (#BucketIdx + 1) MOD 12;
      #Buckets[#BucketIdx] := 0;
   END_IF;

   #sum := 0;
   FOR #i := 0 TO 11 DO
      #sum := #sum + #Buckets[#i];
   END_FOR;
   #Counters.PerHour := #sum * 60;
END_FUNCTION_BLOCK
